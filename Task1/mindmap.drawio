          </mxGeometry>
        </mxCell>
        <mxCell id="15" value="Тип данных: Сами по себе данные не являются строго конфиденциальными, однако не предназначены для публичного доступа. К таким данным могут относиться: логи работы систем, служебная переписка, внутренние инструкции/политики, ряд отчётов, журналы аудита, какая-либо внутренняя аналитика/KPI, данные о зп, описание товаров и услуг" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="-110" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="16" value="" style="endArrow=classic;html=1;" parent="1" source="15" target="13" edge="1">

        <mxCell id="13" value="Внутренние данные" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="160" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="" style="endArrow=classic;html=1;" parent="1" source="13" target="2" edge="1">

<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.16 Chrome/132.0.6834.196 Electron/34.2.0 Safari/537.36" version="26.0.16">
  <diagram name="Страница-1" id="0">
    <mxGraphModel dx="4229" dy="1982" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Безопасность данных" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="440" y="340" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Публичные данные" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="250" y="525" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="" style="endArrow=classic;html=1;" parent="1" source="3" target="2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="210" y="210" as="sourcePoint" />
            <mxPoint x="260" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5" value="Тип данных: Данные, которые получает клиент при просмотре информации о витрине, онлайн туру, общедоступная информация на сайте, реклама и объявления, пресс-релизы, новости, заявления, публичные отчёты, общая информация о компании. Данные не должны никак влиять на внутреннюю структуру компании и каким-либо образом компрометировать как компанию, так и других клиентов" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="675" width="260" height="175" as="geometry" />
        </mxCell>
        <mxCell id="6" value="" style="endArrow=classic;html=1;" parent="1" source="5" target="3" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="150" y="230" as="sourcePoint" />
            <mxPoint x="150" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7" value="Риски: Для публичных данных есть риски некачественных данных, т.к. приведение этих данные в &quot;некачественное&quot;, отличное от целевого состояние может привести к финансовым потерям из-за оттока клиентов." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-210" y="730" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="8" value="" style="endArrow=classic;html=1;" parent="1" source="7" target="5" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="150" y="350" as="sourcePoint" />
            <mxPoint x="150" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9" value="Оценка риска: Некачественные данные - Незначительный риск." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-550" y="742.5" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Обоснование: Данные публичны и их искажение не наносит существенного ущерба" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-550" y="620" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="endArrow=classic;html=1;" parent="1" source="9" target="7" edge="1">

        <mxCell id="17" value="Риски: утечка данных, потеря данных, искажение данных, некачественные данные" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-210" y="-65" width="260" height="60" as="geometry" />

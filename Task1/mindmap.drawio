        <mxCell id="19" value="Оценка риска: утечка данных, искажение данных, некачественные данные - Значительный риск; потеря данных - незначительный" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-550" y="-65" width="260" height="60" as="geometry" />

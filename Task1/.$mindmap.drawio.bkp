                        <mxPoint x="150" y="210" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="7" value="Риски: Для публичных данных есть риски некачественных данных, т.к. приведение этих данные в &quot;некачественное&quot;, отличное от целевого состояние может привести к финансовым потерям из-за оттока клиентов." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
